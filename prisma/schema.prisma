// Shreeji Hero Showroom Management System - Prisma Database Schema
// Standalone Internal ERP - PostgreSQL Baseline

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  SHOWROOM_MANAGER
  SALES_EXECUTIVE
  FRONT_DESK
  SERVICE_MANAGER
  SERVICE_ADVISOR
  ACCOUNTANT
  INVENTORY_MANAGER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
  LOCKED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
  DELIVERED
  DEMO
  IN_TRANSIT
  IN_SERVICE
}

enum LeadSource {
  WALK_IN
  PHONE_INQUIRY
  WEBSITE
  REFERRAL
  EVENT
  SOCIAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  TEST_RIDE
  QUOTATION
  NEGOTIATION
  BOOKED
  CONVERTED
  LOST
}

enum PriorityLevel {
  HOT
  WARM
  COLD
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
  CONVERTED
}

enum FollowUpType {
  CALL
  WHATSAPP
  VISIT
  MEETING
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  RESCHEDULED
}

enum WalkInStatus {
  WAITING
  ASSIGNED
  IN_DISCUSSION
  TEST_RIDE
  COMPLETED
  LEFT
}

enum AppointmentType {
  SALES_CONSULTATION
  TEST_RIDE
  SERVICE_CHECKIN
  VEHICLE_DELIVERY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TestRideStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingStatus {
  PENDING_APPROVAL
  CONFIRMED
  VEHICLE_ALLOCATED
  PAYMENT_PENDING
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PdiStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  FINANCIER
}

enum RtoStatus {
  PENDING
  DOCUMENTS_SUBMITTED
  IN_PROCESS
  APPROVED
  COMPLETED
}

enum DeliveryStatus {
  SCHEDULED
  PDI_PENDING
  PDI_PASSED
  READY_FOR_DELIVERY
  DELIVERED
}

enum ServiceType {
  FREE_SERVICE_1
  FREE_SERVICE_2
  FREE_SERVICE_3
  FREE_SERVICE_4
  FREE_SERVICE_5
  PAID_SERVICE
  RUNNING_REPAIR
  ACCIDENTAL
  WARRANTY_CLAIM
}

enum ServiceBookingStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum JobCardStatus {
  OPEN
  INSPECTION
  ESTIMATE_PENDING
  CUSTOMER_APPROVAL
  WORK_IN_PROGRESS
  QUALITY_CHECK
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum BayStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum JobItemType {
  LABOUR
  PART
}

enum MovementType {
  INWARD
  OUTWARD
  SERVICE_CONSUMPTION
  SALES_CONSUMPTION
  BRANCH_TRANSFER
  ADJUSTMENT
  RETURN
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
}

enum TransferItemType {
  VEHICLE
  SPARE_PART
}

enum TargetType {
  VEHICLE_SALES_COUNT
  SALES_REVENUE
  SERVICE_REVENUE
}

enum TargetStatus {
  IN_PROGRESS
  ACHIEVED
  MISSED
}

enum NotificationPriority {
  INFO
  NORMAL
  IMPORTANT
  CRITICAL
}

enum InvoiceType {
  SALE
  SERVICE
  COUNTER_SALE
}

enum LoanStatus {
  APPLICATION
  APPROVED
  DISBURSEMENT_PENDING
  DISBURSED
  REJECTED
  CLOSED
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum NotificationType {
  LEAD
  SERVICE
  INVENTORY
  FINANCE
  SYSTEM
  TASK
  DELAY
}

// ----------------------------------------------------
// CORE ORGANIZATIONAL ENTITIES
// ----------------------------------------------------

model Branch {
  id          String       @id @default(cuid())
  code        String       @unique // e.g. "SHR-HLV", "SHR-DHN", "SHR-JTP"
  name        String       // e.g. "Halvad Branch"
  address     String
  city        String       // e.g. "Halvad"
  state       String       @default("Gujarat")
  pincode     String
  phone       String
  email       String?
  mapLocation String?
  hasSales    Boolean      @default(true)
  hasService  Boolean      @default(true)
  status      BranchStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  employees        User[]
  customers        Customer[]
  leads            Lead[]
  quotations       Quotation[]
  testRides        TestRide[]
  followUps        FollowUp[]
  walkIns          WalkIn[]
  appointments     Appointment[]
  bookings         Booking[]
  sales            Sale[]
  serviceBays      ServiceBay[]
  serviceBookings  ServiceBooking[]
  jobCards         JobCard[]
  vehicleUnits     VehicleUnit[]
  inventoryStocks  InventoryStock[]
  sourceMovements  StockMovement[]      @relation("SourceBranch")
  targetMovements  StockMovement[]      @relation("TargetBranch")
  sourceTransfers  StockTransferRecord[] @relation("SourceTransferBranch")
  targetTransfers  StockTransferRecord[] @relation("TargetTransferBranch")
  salesTargets     SalesTargetRecord[]
  invoices         Invoice[]
  payments         Payment[]
  refunds          RefundRecord[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([code])
  @@index([city])
  @@index([status])
}

model User {
  id           String        @id @default(cuid())
  employeeCode String        @unique // e.g. "EMP-1001"
  name         String
  email        String        @unique
  passwordHash String
  phone        String
  role         Role
  branchId     String?
  department   String?
  designation  String?
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedLeads      Lead[]               @relation("AssignedSalesExec")
  quotations         Quotation[]          @relation("ExecutiveQuotations")
  testRides          TestRide[]           @relation("ExecutiveTestRides")
  followUps          FollowUp[]           @relation("AssignedFollowUps")
  walkIns            WalkIn[]             @relation("AssignedWalkIns")
  appointments       Appointment[]        @relation("AssignedAppointments")
  sales              Sale[]               @relation("SalesExecutive")
  advisedJobCards    JobCard[]            @relation("ServiceAdvisor")
  techJobCards       JobCard[]            @relation("Technician")
  recordedPayments   Payment[]            @relation("PaymentRecorder")
  approvedRefunds    RefundRecord[]       @relation("RefundApprover")
  requestedTransfers StockTransferRecord[] @relation("TransferRequester")
  approvedTransfers  StockTransferRecord[] @relation("TransferApprover")
  stockMovements     StockMovement[]      @relation("StockActor")
  assignedTargets    SalesTargetRecord[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([role])
  @@index([branchId])
  @@index([status])
}

// ----------------------------------------------------
// CUSTOMER & OWNERSHIP ENTITIES
// ----------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  customerCode String   @unique // e.g. "SHR-1024"
  name         String
  phone        String   @unique
  altPhone     String?
  email        String?
  address      String
  city         String
  state        String   @default("Gujarat")
  pincode      String
  dateOfBirth  DateTime?
  preferredContact String @default("PHONE")
  source       LeadSource @default(WALK_IN)
  branchId     String
  status       String   @default("ACTIVE")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  branch          Branch                  @relation(fields: [branchId], references: [id])
  vehicles        CustomerVehicle[]
  leads           Lead[]
  quotations      Quotation[]
  testRides       TestRide[]
  followUps       FollowUp[]
  walkIns         WalkIn[]
  appointments    Appointment[]
  timelines       CustomerTimeline[]
  bookings        Booking[]
  sales           Sale[]
  serviceBookings ServiceBooking[]
  jobCards        JobCard[]
  invoices        Invoice[]
  payments        Payment[]
  refunds         RefundRecord[]
  financeRecords  FinanceRecord[]
  preferences     CommunicationPreference?

  @@index([phone])
  @@index([customerCode])
  @@index([branchId])
}

model CommunicationPreference {
  id            String   @id @default(cuid())
  customerId    String   @unique
  allowWhatsapp Boolean  @default(true)
  allowSms      Boolean  @default(true)
  allowEmail    Boolean  @default(true)
  allowPortal   Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  // Relationships
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerTimeline {
  id          String   @id @default(cuid())
  customerId  String
  type        String   // e.g. "INQUIRY", "FOLLOW_UP", "TEST_RIDE", "QUOTATION", "BOOKING", "SALE", "SERVICE", "PAYMENT", "PDI", "DELIVERY", "REFUND", "NOTE"
  title       String
  description String
  actorName   String?
  metadata    String?  // JSON metadata
  createdAt   DateTime @default(now())

  // Relationships
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model CustomerVehicle {
  id                 String    @id @default(cuid())
  customerId         String
  registrationNumber String    @unique // e.g. "GJ-36-AB-1234"
  modelName          String    // e.g. "Hero Splendor+"
  variantName        String?   // e.g. "Drum Self Cast"
  color              String?   // e.g. "Black with Sports Red"
  vinNumber          String?   @unique
  engineNumber       String?   @unique
  purchaseDate       DateTime?
  warrantyUntil      DateTime?
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relationships
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceBookings ServiceBooking[]
  jobCards        JobCard[]

  @@index([customerId])
  @@index([registrationNumber])
  @@index([vinNumber])
}

// ----------------------------------------------------
// VEHICLE & INVENTORY ENTITIES
// ----------------------------------------------------

model VehicleModel {
  id             String   @id @default(cuid())
  name           String   @unique // e.g. "Splendor Plus", "HF Deluxe", "Xtreme 160R", "Passion Pro", "Xpulse 200 4V"
  category       String   // e.g. "Commuter", "Executive", "Premium", "Scooter"
  fuelType       String   @default("Petrol")
  cc             Int      // e.g. 97, 125, 163, 199
  basePrice      Decimal  @db.Decimal(10, 2)
  isDiscontinued Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  variants   VehicleVariant[]
  leads      Lead[]
  quotations Quotation[]
  bookings   Booking[]

  @@index([name])
}

model VehicleVariant {
  id              String   @id @default(cuid())
  modelId         String
  name            String   // e.g. "Drum Self Cast", "Disc Self Cast", "XTEC Drum"
  exShowroomPrice Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  model        VehicleModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  vehicleUnits VehicleUnit[]
  bookings     Booking[]

  @@unique([modelId, name])
}

model VehicleUnit {
  id            String        @id @default(cuid())
  vin           String        @unique // Chassis Number e.g. "MBLHAW14XN9XXXXX1"
  engineNumber  String        @unique // e.g. "HA10EHNXXXXX1"
  variantId     String
  color         String        // e.g. "Black Nexus Blue"
  branchId      String
  status        VehicleStatus @default(AVAILABLE)
  purchasePrice Decimal       @db.Decimal(10, 2)
  sellingPrice  Decimal       @db.Decimal(10, 2)
  arrivalDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  variant        VehicleVariant        @relation(fields: [variantId], references: [id])
  branch         Branch                @relation(fields: [branchId], references: [id])
  testRides      TestRide[]
  bookings       Booking[]
  sales          Sale[]
  pdiRecords     PdiRecord[]
  stockMovements StockMovement[]
  transfers      StockTransferRecord[]

  @@index([vin])
  @@index([engineNumber])
  @@index([branchId])
  @@index([status])
}

// ----------------------------------------------------
// SALES, LEADS, QUOTATIONS, BOOKINGS & DELIVERIES
// ----------------------------------------------------

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique // e.g. "QT-2024-001"
  customerId         String
  branchId           String
  salesExecutiveId   String?
  modelId            String
  variantName        String
  color              String
  exShowroomPrice    Decimal         @db.Decimal(10, 2)
  rtoCharges         Decimal         @default(0) @db.Decimal(10, 2)
  insuranceCharges   Decimal         @default(0) @db.Decimal(10, 2)
  accessoriesCharges Decimal         @default(0) @db.Decimal(10, 2)
  discount           Decimal         @default(0) @db.Decimal(10, 2)
  onRoadPrice        Decimal         @db.Decimal(10, 2)
  downPayment        Decimal?        @db.Decimal(10, 2)
  loanAmount         Decimal?        @db.Decimal(10, 2)
  estimatedEmi       Decimal?        @db.Decimal(10, 2)
  tenureMonths       Int?            @default(24)
  status             QuotationStatus @default(DRAFT)
  validUntil         DateTime
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relationships
  customer       Customer     @relation(fields: [customerId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  salesExecutive User?        @relation("ExecutiveQuotations", fields: [salesExecutiveId], references: [id])
  model          VehicleModel @relation(fields: [modelId], references: [id])

  @@index([quotationNumber])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
}

model Lead {
  id                   String        @id @default(cuid())
  leadCode             String        @unique // e.g. "LD-2026-001"
  customerId           String
  branchId             String
  assignedToId         String?
  modelId              String?
  variantName          String?
  source               LeadSource    @default(WALK_IN)
  status               LeadStatus    @default(NEW)
  priority             PriorityLevel @default(HOT)
  estimatedValue       Decimal?      @db.Decimal(10, 2)
  expectedPurchaseDate DateTime?
  lostReason           String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relationships
  customer   Customer      @relation(fields: [customerId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  assignedTo User?         @relation("AssignedSalesExec", fields: [assignedToId], references: [id])
  model      VehicleModel? @relation(fields: [modelId], references: [id])
  followUps  FollowUp[]
  testRides  TestRide[]
  bookings   Booking[]

  @@index([leadCode])
  @@index([branchId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
}

model FollowUp {
  id               String         @id @default(cuid())
  leadId           String
  customerId       String
  branchId         String
  assignedToId     String
  type             FollowUpType   @default(CALL)
  status           FollowUpStatus @default(PENDING)
  scheduledAt      DateTime
  completedAt      DateTime?
  notes            String
  customerResponse String?
  nextFollowUpDate DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relationships
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id])
  assignedTo User     @relation("AssignedFollowUps", fields: [assignedToId], references: [id])

  @@index([leadId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledAt])
}

model WalkIn {
  id              String       @id @default(cuid())
  customerId      String
  branchId        String
  assignedToId    String?
  purpose         String       @default("NEW_PURCHASE") // NEW_PURCHASE, TEST_RIDE, SERVICE, GENERAL_INQUIRY
  interestedModel String?
  status          WalkInStatus @default(WAITING)
  entryTime       DateTime     @default(now())
  exitTime        DateTime?
  notes           String?
  createdAt       DateTime     @default(now())

  // Relationships
  customer   Customer @relation(fields: [customerId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])
  assignedTo User?    @relation("AssignedWalkIns", fields: [assignedToId], references: [id])

  @@index([branchId])
  @@index([status])
  @@index([entryTime])
}

model Appointment {
  id              String            @id @default(cuid())
  customerId      String
  branchId        String
  assignedToId    String?
  type            AppointmentType   @default(SALES_CONSULTATION)
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  customer   Customer @relation(fields: [customerId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])
  assignedTo User?    @relation("AssignedAppointments", fields: [assignedToId], references: [id])

  @@index([branchId])
  @@index([scheduledAt])
  @@index([status])
}

model TestRide {
  id            String         @id @default(cuid())
  customerId    String
  leadId        String?
  branchId      String
  vehicleUnitId String?
  executiveId   String?
  scheduledAt   DateTime
  completedAt   DateTime?
  status        TestRideStatus @default(SCHEDULED)
  feedback      String?
  remarks       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  customer    Customer     @relation(fields: [customerId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  vehicleUnit VehicleUnit? @relation(fields: [vehicleUnitId], references: [id])
  executive   User?        @relation("ExecutiveTestRides", fields: [executiveId], references: [id])

  @@index([branchId])
  @@index([scheduledAt])
  @@index([status])
}

model Booking {
  id            String        @id @default(cuid())
  bookingCode   String        @unique // e.g. "BK-1001"
  customerId    String
  leadId        String?
  branchId      String
  modelId       String?
  variantId     String?
  vehicleUnitId String?
  bookingAmount Decimal       @db.Decimal(10, 2)
  paymentMode   PaymentMethod @default(UPI)
  paymentStatus PaymentStatus @default(PAID)
  status        BookingStatus @default(PENDING_APPROVAL)
  deliveryDate  DateTime?
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  customer    Customer        @relation(fields: [customerId], references: [id])
  lead        Lead?           @relation(fields: [leadId], references: [id])
  branch      Branch          @relation(fields: [branchId], references: [id])
  model       VehicleModel?   @relation(fields: [modelId], references: [id])
  variant     VehicleVariant? @relation(fields: [variantId], references: [id])
  vehicleUnit VehicleUnit?    @relation(fields: [vehicleUnitId], references: [id])
  sale        Sale?
  pdiRecord   PdiRecord?

  @@index([bookingCode])
  @@index([branchId])
  @@index([status])
}

model PdiRecord {
  id                 String    @id @default(cuid())
  bookingId          String    @unique
  vehicleUnitId      String
  status             PdiStatus @default(PENDING)
  cleanlinessPassed  Boolean   @default(true)
  bodyPassed         Boolean   @default(true)
  tyresPassed        Boolean   @default(true)
  batteryPassed      Boolean   @default(true)
  lightsPassed       Boolean   @default(true)
  hornPassed         Boolean   @default(true)
  fuelLevel          String    @default("2 Litres")
  odometerReading    Int       @default(2) // e.g. 2 km
  keysCount          Int       @default(2)
  toolkitPresent     Boolean   @default(true)
  ownerManualPresent Boolean   @default(true)
  failureReason      String?
  inspectedAt        DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  // Relationships
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicleUnit VehicleUnit @relation(fields: [vehicleUnitId], references: [id])

  @@index([bookingId])
  @@index([status])
}

model Sale {
  id                 String         @id @default(cuid())
  invoiceNumber      String         @unique // e.g. "INV-2026-1001"
  customerId         String
  bookingId          String?        @unique
  vehicleUnitId      String
  branchId           String
  salesExecutiveId   String?
  exShowroomPrice    Decimal        @db.Decimal(10, 2)
  rtoCharges         Decimal        @db.Decimal(10, 2) @default(0)
  insuranceCharges   Decimal        @db.Decimal(10, 2) @default(0)
  accessoriesCharges Decimal        @db.Decimal(10, 2) @default(0)
  discount           Decimal        @db.Decimal(10, 2) @default(0)
  totalAmount        Decimal        @db.Decimal(10, 2)
  paymentStatus      PaymentStatus  @default(PENDING)
  rtoStatus          RtoStatus      @default(PENDING)
  deliveryStatus     DeliveryStatus @default(SCHEDULED)
  saleDate           DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relationships
  customer       Customer        @relation(fields: [customerId], references: [id])
  booking        Booking?        @relation(fields: [bookingId], references: [id])
  vehicleUnit    VehicleUnit     @relation(fields: [vehicleUnitId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  salesExecutive User?           @relation("SalesExecutive", fields: [salesExecutiveId], references: [id])
  invoices       Invoice[]
  financeRecord  FinanceRecord?

  @@index([invoiceNumber])
  @@index([branchId])
  @@index([saleDate])
  @@index([paymentStatus])
}

// ----------------------------------------------------
// SERVICE OPERATIONS & WORKSHOP ENTITIES
// ----------------------------------------------------

model ServiceBay {
  id               String    @id @default(cuid())
  code             String    // e.g. "BAY-01", "BAY-02"
  name             String    // e.g. "Bay 1 - Express Lube"
  branchId         String
  status           BayStatus @default(AVAILABLE)
  currentJobCardId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relationships
  branch         Branch   @relation(fields: [branchId], references: [id])
  currentJobCard JobCard? @relation("ActiveBayJob", fields: [currentJobCardId], references: [id])

  @@unique([branchId, code])
  @@index([branchId])
  @@index([status])
}

model ServiceBooking {
  id            String               @id @default(cuid())
  bookingCode   String               @unique // e.g. "SR-1001"
  customerId    String
  vehicleId     String
  branchId      String
  serviceType   ServiceType          @default(PAID_SERVICE)
  scheduledDate DateTime
  status        ServiceBookingStatus @default(REQUESTED)
  remarks       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relationships
  customer Customer        @relation(fields: [customerId], references: [id])
  vehicle  CustomerVehicle @relation(fields: [vehicleId], references: [id])
  branch   Branch          @relation(fields: [branchId], references: [id])
  jobCard  JobCard?

  @@index([bookingCode])
  @@index([branchId])
  @@index([scheduledDate])
}

model JobCard {
  id                 String        @id @default(cuid())
  jobCardNumber      String        @unique // e.g. "JC-8901"
  serviceBookingId   String?       @unique
  customerId         String
  vehicleId          String
  branchId           String
  advisorId          String?
  technicianId       String?
  bayId              String?
  serviceType        ServiceType   @default(PAID_SERVICE)
  customerComplaints String
  inspectionFindings String?
  fuelLevel          String?       // e.g. "1/2 Tank", "Reserve", "Full Tank"
  kmReading          Int?
  status             JobCardStatus @default(OPEN)
  estDelivery        DateTime?
  totalLabour        Decimal       @default(0) @db.Decimal(10, 2)
  totalParts         Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal       @default(0) @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?

  // Relationships
  serviceBooking ServiceBooking?      @relation(fields: [serviceBookingId], references: [id])
  customer       Customer             @relation(fields: [customerId], references: [id])
  vehicle        CustomerVehicle      @relation(fields: [vehicleId], references: [id])
  branch         Branch               @relation(fields: [branchId], references: [id])
  advisor        User?                @relation("ServiceAdvisor", fields: [advisorId], references: [id])
  technician     User?                @relation("Technician", fields: [technicianId], references: [id])
  assignedBay    ServiceBay?          @relation("ActiveBayJob")
  items          JobCardItem[]
  approvals      ServiceApproval[]
  inspection     ServiceInspection?
  qualityCheck   ServiceQualityCheck?
  invoices       Invoice[]

  @@index([jobCardNumber])
  @@index([branchId])
  @@index([status])
  @@index([advisorId])
  @@index([technicianId])
}

model ServiceInspection {
  id                        String   @id @default(cuid())
  jobCardId                 String   @unique
  engineCondition           String   @default("NORMAL")
  brakesCondition           String   @default("GOOD")
  tyresCondition            String   @default("OK")
  batteryVoltage            String   @default("12.6V")
  lightsFunctional          Boolean  @default(true)
  suspensionOk              Boolean  @default(true)
  fluidsLevel               String   @default("NORMAL")
  bodyScratchesNotes        String?
  additionalWorkRecommended String?
  estimatedAdditionalCost   Decimal  @default(0) @db.Decimal(10, 2)
  inspectedAt               DateTime @default(now())

  // Relationships
  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model ServiceApproval {
  id                   String   @id @default(cuid())
  jobCardId            String
  requestedDescription String
  estimatedCost        Decimal  @db.Decimal(10, 2)
  status               String   @default("PENDING") // PENDING, APPROVED, REJECTED
  customerNotes        String?
  approvedAt           DateTime?
  createdAt            DateTime @default(now())

  // Relationships
  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
  @@index([status])
}

model ServiceQualityCheck {
  id                   String   @id @default(cuid())
  jobCardId            String   @unique
  workCompleted        Boolean  @default(true)
  partsInstalled       Boolean  @default(true)
  vehicleCleaned       Boolean  @default(true)
  warningLightsChecked Boolean  @default(true)
  testRideCompleted    Boolean  @default(true)
  status               String   @default("PASSED") // PENDING, PASSED, FAILED
  checkedBy            String
  notes                String?
  checkedAt            DateTime @default(now())

  // Relationships
  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
  @@index([status])
}

model JobCardItem {
  id          String      @id @default(cuid())
  jobCardId   String
  itemType    JobItemType @default(LABOUR)
  sparePartId String?
  description String
  qty         Int         @default(1)
  unitPrice   Decimal     @db.Decimal(10, 2)
  gstRate     Decimal     @default(18) @db.Decimal(4, 2) // GST % e.g. 18.00
  totalAmount Decimal     @db.Decimal(10, 2)

  // Relationships
  jobCard   JobCard    @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  sparePart SparePart? @relation(fields: [sparePartId], references: [id])

  @@index([jobCardId])
}

// ----------------------------------------------------
// SPARE PARTS & STOCK ENTITIES
// ----------------------------------------------------

model SparePart {
  id            String   @id @default(cuid())
  partNumber    String   @unique // e.g. "SP-ENG-001", "SP-BRK-102"
  name          String   // e.g. "Engine Oil 4T Plus (1L)", "Brake Pad Front"
  category      String   // e.g. "Lubricant", "Brakes", "Filters", "Electricals"
  brand         String   @default("Hero Genuine Parts")
  unitPrice     Decimal  @db.Decimal(10, 2)
  costPrice     Decimal  @db.Decimal(10, 2)
  gstRate       Decimal  @default(18) @db.Decimal(4, 2)
  minStockLevel Int      @default(5)
  hsnCode       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  jobCardItems    JobCardItem[]
  inventoryStocks InventoryStock[]
  stockMovements  StockMovement[]
  transfers       StockTransferRecord[]

  @@index([partNumber])
  @@index([category])
}

model InventoryStock {
  id          String   @id @default(cuid())
  sparePartId String
  branchId    String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  // Relationships
  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([sparePartId, branchId])
  @@index([branchId])
}

model StockMovement {
  id             String       @id @default(cuid())
  sparePartId    String?
  vehicleUnitId  String?
  sourceBranchId String?
  targetBranchId String?
  movementType   MovementType
  quantity       Int          @default(1)
  reason         String?
  actorId        String
  createdAt      DateTime     @default(now())

  // Relationships
  sparePart    SparePart?   @relation(fields: [sparePartId], references: [id])
  vehicleUnit  VehicleUnit? @relation(fields: [vehicleUnitId], references: [id])
  sourceBranch Branch?      @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  targetBranch Branch?      @relation("TargetBranch", fields: [targetBranchId], references: [id])
  actor        User         @relation("StockActor", fields: [actorId], references: [id])

  @@index([movementType])
  @@index([createdAt])
}

model StockTransferRecord {
  id             String           @id @default(cuid())
  transferCode   String           @unique // e.g. "TRF-2024-001"
  itemType       TransferItemType @default(VEHICLE)
  vehicleUnitId  String?
  sparePartId    String?
  quantity       Int              @default(1)
  sourceBranchId String
  targetBranchId String
  status         TransferStatus   @default(REQUESTED)
  requestedById  String
  approvedById   String?
  notes          String?
  requestedAt    DateTime         @default(now())
  receivedAt     DateTime?

  // Relationships
  vehicleUnit  VehicleUnit? @relation(fields: [vehicleUnitId], references: [id])
  sparePart    SparePart?   @relation(fields: [sparePartId], references: [id])
  sourceBranch Branch       @relation("SourceTransferBranch", fields: [sourceBranchId], references: [id])
  targetBranch Branch       @relation("TargetTransferBranch", fields: [targetBranchId], references: [id])
  requestedBy  User         @relation("TransferRequester", fields: [requestedById], references: [id])
  approvedBy   User?        @relation("TransferApprover", fields: [approvedById], references: [id])

  @@index([transferCode])
  @@index([sourceBranchId])
  @@index([targetBranchId])
  @@index([status])
}

model Vendor {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "VND-101"
  name          String   // e.g. "Hero MotoCorp Ltd (Parts Div)"
  contactPerson String?
  phone         String
  email         String?
  gstNumber     String?
  address       String
  city          String
  state         String   @default("Gujarat")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
}

// ----------------------------------------------------
// TARGETS & KPI ENTITIES
// ----------------------------------------------------

model SalesTargetRecord {
  id            String       @id @default(cuid())
  month         String       // e.g. "2024-05"
  branchId      String
  employeeId    String?
  targetType    TargetType   @default(VEHICLE_SALES_COUNT)
  targetValue   Decimal      @db.Decimal(12, 2)
  achievedValue Decimal      @default(0) @db.Decimal(12, 2)
  status        TargetStatus @default(IN_PROGRESS)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relationships
  branch   Branch @relation(fields: [branchId], references: [id])
  employee User?  @relation(fields: [employeeId], references: [id])

  @@index([month])
  @@index([branchId])
  @@index([employeeId])
}

// ----------------------------------------------------
// FINANCE, INVOICES, PAYMENTS & REFUNDS
// ----------------------------------------------------

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // e.g. "INV-1001", "INV-2024-1258"
  invoiceType   InvoiceType   @default(SALE)
  customerId    String
  saleId        String?
  jobCardId     String?
  branchId      String
  subtotal      Decimal       @db.Decimal(10, 2)
  gstAmount     Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])
  jobCard  JobCard? @relation(fields: [jobCardId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  payments Payment[]
  refunds  RefundRecord[]

  @@index([invoiceNumber])
  @@index([branchId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  paymentCode     String        @unique // e.g. "PAY-2026-001"
  invoiceId       String?
  customerId      String
  branchId        String
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(CASH)
  referenceNumber String?       // e.g. UPI Ref / Cheque No
  status          String        @default("SUCCESS") // SUCCESS, PENDING, FAILED
  notes           String?
  recordedById    String
  createdAt       DateTime      @default(now())

  // Relationships
  invoice    Invoice?        @relation(fields: [invoiceId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  branch     Branch          @relation(fields: [branchId], references: [id])
  recordedBy User            @relation("PaymentRecorder", fields: [recordedById], references: [id])
  refunds    RefundRecord[]

  @@index([paymentCode])
  @@index([branchId])
  @@index([createdAt])
}

model RefundRecord {
  id              String       @id @default(cuid())
  refundCode      String       @unique // e.g. "REF-2024-001"
  paymentId       String?
  invoiceId       String?
  customerId      String
  branchId        String
  amount          Decimal      @db.Decimal(10, 2)
  reason          String
  refundMethod    PaymentMethod @default(UPI)
  referenceNumber String?
  status          RefundStatus  @default(PENDING)
  approvedById    String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  // Relationships
  payment    Payment? @relation(fields: [paymentId], references: [id])
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])
  approvedBy User?    @relation("RefundApprover", fields: [approvedById], references: [id])

  @@index([refundCode])
  @@index([branchId])
  @@index([status])
}

model FinanceRecord {
  id              String     @id @default(cuid())
  saleId          String     @unique
  customerId      String
  loanProvider    String     // e.g. "Hero FinCorp", "HDFC Bank", "L&T Finance"
  applicationNo   String?    @unique // e.g. "HFC-2024-8901"
  loanAmount      Decimal    @db.Decimal(10, 2)
  tenureMonths    Int        // e.g. 24, 36
  monthlyEmi      Decimal    @db.Decimal(10, 2)
  downPayment     Decimal    @db.Decimal(10, 2)
  emiStartDate    DateTime
  status          LoanStatus @default(APPROVED)
  disbursedAmount Decimal?   @db.Decimal(10, 2)
  disbursedAt     DateTime?
  disbursalRef    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relationships
  sale     Sale     @relation(fields: [saleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([loanProvider])
  @@index([status])
}

// ----------------------------------------------------
// SYSTEM, NOTIFICATION & AUDIT LOG ENTITIES
// ----------------------------------------------------

model Notification {
  id        String               @id @default(cuid())
  userId    String?
  targetRole Role?
  customerId String?
  branchId  String?
  title     String
  message   String
  type      NotificationType     @default(SYSTEM)
  priority  NotificationPriority @default(NORMAL)
  module    String               @default("GENERAL") // SALES, SERVICE, FINANCE, INVENTORY, CRM
  recordId  String?
  isRead    Boolean              @default(false)
  linkUrl   String?
  createdAt DateTime             @default(now())

  // Relationships
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([targetRole])
  @@index([customerId])
  @@index([branchId])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  branchId      String?
  action        String   // e.g. "CREATE", "UPDATE", "STATUS_CHANGE", "DELETE", "INVOICE_CREATE", "PAYMENT_RECORD", "REFUND_APPROVE", "LOAN_DISBURSE", "STOCK_INWARD", "STOCK_TRANSFER", "TARGET_UPDATE", "REPORT_EXPORT", "PREFERENCE_CHANGE"
  entity        String   // e.g. "Invoice", "Payment", "RefundRecord", "FinanceRecord", "JobCard", "Customer", "VehicleUnit", "SparePart", "StockTransferRecord", "SalesTargetRecord", "CommunicationPreference"
  entityId      String
  changeDetails String?  // JSON string or summary of old -> new values
  ipAddress     String?
  createdAt     DateTime @default(now())

  // Relationships
  actor  User    @relation(fields: [actorId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
