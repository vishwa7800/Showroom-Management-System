# Shreeji Hero Showroom Management System - Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: NEVER commit real secret keys or passwords to version control.
# Copy this file to .env and replace placeholder values with your real production secrets.
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
NODE_ENV=production
APP_URL=https://erp.shreejihero.com
NEXT_PUBLIC_APP_NAME="Shreeji Hero Showroom ERP"

# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# Replace with your local PostgreSQL or cloud PostgreSQL (Supabase, Neon, AWS RDS, Railway, etc.)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public&sslmode=require
DATABASE_URL="postgresql://shreeji_admin:SecurePass2026@db.shreejihero.internal:5432/shreeji_hero_erp?schema=public&sslmode=require"

# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# Minimum 32-character high-entropy secret keys for JWT session signing
JWT_SECRET="shreeji_hero_jwt_production_secret_key_minimum_32_characters_long"
AUTH_SECRET="shreeji_hero_auth_production_secret_key_minimum_32_characters_long"
NEXTAUTH_URL="https://erp.shreejihero.com"
SESSION_COOKIE_NAME="shreeji_hero_session"

# 4. COMMUNICATION GATEWAYS (SMS, WhatsApp, Email)
# SMS Gateway (MSG91 / Twilio)
SMS_API_KEY=""
SMS_SENDER_ID="SHREEJI"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Meta WhatsApp Cloud API Gateway
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Dealership SMTP Email Gateway
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="notifications@shreejihero.com"

# 5. ONLINE PAYMENT GATEWAY (Optional: For online customer token/invoice checkout)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# 6. DOCUMENT STORAGE (AWS S3 / Cloudflare R2 for KYC, DL & Invoices)
S3_BUCKET_NAME="shreeji-hero-documents"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# 7. OBSERVABILITY & ERROR MONITORING (Sentry)
SENTRY_DSN=""

